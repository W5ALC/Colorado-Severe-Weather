#!/usr/bin/env bash
# =============================================================================
# Colorado Severe Weather Network — Setup Script
# Supports: Debian/Ubuntu (apt), Fedora/RHEL (dnf/yum), Arch (pacman),
#           openSUSE (zypper), Gentoo (emerge)
# Run as a normal user — sudo is called internally as needed.
# =============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Colours & helpers (mirrors the NetLogger installer style)
# ---------------------------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

info()    { echo -e "${CYAN}[INFO]${NC}  $*"; }
success() { echo -e "${GREEN}[OK]${NC}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC}  $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }
header()  { echo -e "\n${BOLD}${CYAN}===  $*  ===${NC}\n"; }

# ---------------------------------------------------------------------------
# Globals
# ---------------------------------------------------------------------------
SCRIPT_VERSION="1.0.0"
CSWN_PY_URL="https://raw.githubusercontent.com/W5ALC/Colorado-Severe-Weather/refs/heads/main/Severe-Weather-Network-cli.py"
LOG_FILE="/var/log/cswn_install.log"
INSTALL_DIR="$HOME/cswn"
VENV_DIR="$INSTALL_DIR/venv"

log_and_exit() {
    echo -e "$1" | tee -a "$LOG_FILE"
    exit "${2:-1}"
}

# Redirect all output to the log as well
exec > >(tee -a "$LOG_FILE") 2>&1

# ---------------------------------------------------------------------------
# Must NOT be run as root (venv/home-dir install; sudo called as needed)
# ---------------------------------------------------------------------------
if [[ $EUID -eq 0 ]]; then
    log_and_exit "${RED}[ERROR]${NC} Please run as a normal user, not root. sudo will be called as needed." 1
fi

# ---------------------------------------------------------------------------
# Uninstall mode
# ---------------------------------------------------------------------------
uninstall_cswn() {
    header "Uninstalling Colorado Severe Weather Network"
    info "Removing installed files..."
    rm -rf "$INSTALL_DIR"
    rm -f "$HOME/.cswn_env"
    sudo rm -f "$LOG_FILE"
    log_and_exit "${GREEN}[OK]${NC}    CSWN uninstalled successfully." 0
}

if [[ "${1:-}" == "uninstall" ]]; then
    uninstall_cswn
fi

# ---------------------------------------------------------------------------
# Banner
# ---------------------------------------------------------------------------
header "Colorado Severe Weather Network — Setup v${SCRIPT_VERSION}"

# ---------------------------------------------------------------------------
# Python version check (3.7+)
# ---------------------------------------------------------------------------
PY=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "0.0")
PY_MAJOR=$(echo "$PY" | cut -d. -f1)
PY_MINOR=$(echo "$PY" | cut -d. -f2)

if [[ "$PY_MAJOR" -lt 3 || ("$PY_MAJOR" -eq 3 && "$PY_MINOR" -lt 7) ]]; then
    error "Python 3.7 or newer is required. Found: $PY"
    log_and_exit "Run: sudo apt-get install -y python3   (or equivalent for your distro)" 1
fi
success "Python $PY found."

# ---------------------------------------------------------------------------
# Detect package manager (same logic as the NetLogger installer)
# ---------------------------------------------------------------------------
if command -v dnf &>/dev/null; then
    PKG_MANAGER="dnf"
    INSTALL_CMD="sudo dnf install -y"
    PYTHON_VENV_PKG="python3-pip python3-virtualenv"
    TEX_PKGS="texlive-latex texlive-collection-latexextra cm-super"
elif command -v yum &>/dev/null; then
    PKG_MANAGER="yum"
    INSTALL_CMD="sudo yum install -y"
    PYTHON_VENV_PKG="python3-pip python3-virtualenv"
    TEX_PKGS="texlive texlive-latex"
elif command -v apt-get &>/dev/null; then
    PKG_MANAGER="apt"
    INSTALL_CMD="sudo apt-get install -y"
    PYTHON_VENV_PKG="python3-pip python3-venv"
    TEX_PKGS="texlive-latex-base texlive-latex-extra texlive-latex-recommended cm-super"
elif command -v pacman &>/dev/null; then
    PKG_MANAGER="pacman"
    INSTALL_CMD="sudo pacman -S --noconfirm"
    PYTHON_VENV_PKG="python-pip python-virtualenv"
    TEX_PKGS="texlive-core texlive-latexextra"
elif command -v zypper &>/dev/null; then
    PKG_MANAGER="zypper"
    INSTALL_CMD="sudo zypper install -y"
    PYTHON_VENV_PKG="python3-pip python3-virtualenv"
    TEX_PKGS="texlive texlive-latex"
elif command -v emerge &>/dev/null; then
    PKG_MANAGER="emerge"
    INSTALL_CMD="sudo emerge"
    PYTHON_VENV_PKG="dev-python/pip"
    TEX_PKGS="app-text/texlive"
else
    log_and_exit "${RED}[ERROR]${NC} Unsupported package manager. Exiting." 2
fi

success "Package manager detected: $PKG_MANAGER"

# ---------------------------------------------------------------------------
# Check for required tools: wget, curl
# ---------------------------------------------------------------------------
header "Step 1 — Required Tools"

for tool in wget curl; do
    if ! command -v "$tool" &>/dev/null; then
        info "Installing $tool..."
        $INSTALL_CMD "$tool" || log_and_exit "${RED}[ERROR]${NC} Failed to install $tool. Exiting." 3
    else
        success "$tool already present."
    fi
done

# ---------------------------------------------------------------------------
# Collect operator information
# ---------------------------------------------------------------------------
header "Step 2 — Operator Information"
info "Enter your operator information (press Enter to keep the shown default)."
echo ""

read -rp "Net Control callsign  [NC2WX]:  " NC_CALLSIGN
read -rp "Net Control name      [Gary]:   " NC_NAME
read -rp "Net Control location  [Pueblo West in Southeastern Colorado]: " NC_LOCATION
read -rp "Logger callsign       [W7JPJ]:  " LOGGER_CALLSIGN
read -rp "Logger name           [John]:   " LOGGER_NAME
read -rp "Logger location       [Denver, CO]: " LOGGER_LOCATION

NC_CALLSIGN="${NC_CALLSIGN:-NC2WX}"
NC_NAME="${NC_NAME:-Gary}"
NC_LOCATION="${NC_LOCATION:-Pueblo West in Southeastern Colorado}"
LOGGER_CALLSIGN="${LOGGER_CALLSIGN:-W7JPJ}"
LOGGER_NAME="${LOGGER_NAME:-John}"
LOGGER_LOCATION="${LOGGER_LOCATION:-Denver, CO}"

DEFAULT_OUTPUT_DIR="$HOME/cswn/output"
read -rp "Output directory for generated scripts [$DEFAULT_OUTPUT_DIR]: " OUTPUT_DIR
OUTPUT_DIR="${OUTPUT_DIR:-$DEFAULT_OUTPUT_DIR}"

# ---------------------------------------------------------------------------
# PDF / TeX-only choice  (before disk space check so we know what's needed)
# ---------------------------------------------------------------------------
echo ""
echo "The script can compile a PDF (requires ~600 MB of TeX Live on disk),"
echo "or produce a .tex file only, which you can compile elsewhere."
echo ""
read -rp "Install TeX Live and compile PDFs directly? [Y/n] " INSTALL_TEX
INSTALL_TEX="${INSTALL_TEX:-y}"

# ---------------------------------------------------------------------------
# Disk space check
# ---------------------------------------------------------------------------
header "Step 3 — Disk Space Check"

NEEDED_MB=700
[[ "${INSTALL_TEX,,}" == "n" ]] && NEEDED_MB=100

FREE_MB=$(df --output=avail -m "$HOME" | tail -1 | tr -d ' ')
info "Free space: ${FREE_MB} MB — required: ${NEEDED_MB} MB"

if [[ "$FREE_MB" -lt "$NEEDED_MB" ]]; then
    log_and_exit "${RED}[ERROR]${NC} Not enough disk space. Free at least ${NEEDED_MB} MB and re-run." 1
fi
success "Disk space OK."

# ---------------------------------------------------------------------------
# System packages
# ---------------------------------------------------------------------------
header "Step 4 — System Packages"

if [[ "$PKG_MANAGER" == "apt" ]]; then
    info "Updating package lists..."
    sudo apt-get update -qq
fi

info "Installing Python venv support..."
$INSTALL_CMD $PYTHON_VENV_PKG || log_and_exit "${RED}[ERROR]${NC} Failed to install Python venv packages. Exiting." 3

if [[ "${INSTALL_TEX,,}" != "n" ]]; then
    info "Installing TeX Live (this can take 5–15 minutes on slower hardware — please wait)..."
    $INSTALL_CMD $TEX_PKGS || log_and_exit "${RED}[ERROR]${NC} Failed to install TeX Live packages. Exiting." 3
    success "TeX Live installed."
else
    warn "Skipping TeX Live. The launcher will use --tex-only automatically."
fi

success "System packages done."

# ---------------------------------------------------------------------------
# Download the CSWN Python script from GitHub
# ---------------------------------------------------------------------------
header "Step 5 — Download CSWN Script"

mkdir -p "$INSTALL_DIR"
SCRIPT_DST="$INSTALL_DIR/Severe-Weather-Network-cli.py"

info "Downloading Severe-Weather-Network-cli.py from GitHub..."
wget "$CSWN_PY_URL" -O "$SCRIPT_DST" \
    || log_and_exit "${RED}[ERROR]${NC} Failed to download CSWN script. Check your internet connection and try again." 4

chmod +x "$SCRIPT_DST"
success "Downloaded to $SCRIPT_DST"

# ---------------------------------------------------------------------------
# Python virtual environment
# ---------------------------------------------------------------------------
header "Step 6 — Python Environment"

if [[ ! -d "$VENV_DIR" ]]; then
    info "Creating virtual environment at $VENV_DIR ..."
    python3 -m venv "$VENV_DIR"
else
    info "Virtual environment already exists — reusing."
fi

info "Installing Python dependencies..."
"$VENV_DIR/bin/pip" install --upgrade pip --quiet
"$VENV_DIR/bin/pip" install pytz requests beautifulsoup4 --quiet
success "Python dependencies installed."

# ---------------------------------------------------------------------------
# Config file
# ---------------------------------------------------------------------------
header "Step 7 — Configuration File"

ENV_FILE="$HOME/.cswn_env"
cat > "$ENV_FILE" << EOF
# Colorado Severe Weather Network — operator configuration
# Edit this file to change your callsign, name, or location.

export NET_CONTROL_CALLSIGN="${NC_CALLSIGN}"
export NET_CONTROL_NAME="${NC_NAME}"
export NET_CONTROL_LOCATION="${NC_LOCATION}"
export LOGGER_CALLSIGN="${LOGGER_CALLSIGN}"
export LOGGER_NAME="${LOGGER_NAME}"
export LOGGER_LOCATION="${LOGGER_LOCATION}"
EOF

chmod 600 "$ENV_FILE"
success "Config written to $ENV_FILE"

# ---------------------------------------------------------------------------
# Launcher script
# ---------------------------------------------------------------------------
header "Step 8 — Launcher Script"

mkdir -p "$OUTPUT_DIR"

TEX_FLAG=""
[[ "${INSTALL_TEX,,}" == "n" ]] && TEX_FLAG="--tex-only"

LAUNCHER="$INSTALL_DIR/run_net_script.sh"
cat > "$LAUNCHER" << LAUNCHER_EOF
#!/usr/bin/env bash
# Colorado Severe Weather Network — Net Script Launcher
# Edit ~/.cswn_env to change operator info.

set -euo pipefail
source "\$HOME/.cswn_env"

STAMP=\$(date +%Y%m%d_%H%M)
OUTPUT_BASE="${OUTPUT_DIR}/Colorado_SWO_Net_\${STAMP}"

echo "Colorado Severe Weather Network — Script Generator"
echo "Net Control : \${NET_CONTROL_CALLSIGN} (\${NET_CONTROL_NAME}) @ \${NET_CONTROL_LOCATION}"
echo "Logger      : \${LOGGER_CALLSIGN} (\${LOGGER_NAME}) @ \${LOGGER_LOCATION}"
echo ""

"${VENV_DIR}/bin/python" "${SCRIPT_DST}" \\
    --callsign        "\${NET_CONTROL_CALLSIGN}" \\
    --name            "\${NET_CONTROL_NAME}" \\
    --location        "\${NET_CONTROL_LOCATION}" \\
    --logger-callsign "\${LOGGER_CALLSIGN}" \\
    --logger-name     "\${LOGGER_NAME}" \\
    --logger-location "\${LOGGER_LOCATION}" \\
    --output          "\${OUTPUT_BASE}" \\
    ${TEX_FLAG} \\
    "\$@"
LAUNCHER_EOF

chmod +x "$LAUNCHER"
success "Launcher written to $LAUNCHER"

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
header "Setup Complete"

echo -e "  Python venv    : ${CYAN}$VENV_DIR${NC}"
echo -e "  CSWN script    : ${CYAN}$SCRIPT_DST${NC}"
echo -e "  Operator cfg   : ${CYAN}$ENV_FILE${NC}"
echo -e "  Output folder  : ${CYAN}$OUTPUT_DIR${NC}"
echo -e "  Install log    : ${CYAN}$LOG_FILE${NC}"
echo ""
echo -e "  ${BOLD}To generate a net script, run:${NC}"
echo -e "    $LAUNCHER"
echo ""
echo -e "  To test without hitting NWS servers:"
echo -e "    $LAUNCHER --skip-nws"
echo ""
echo -e "  To change your callsign/name/location, edit:"
echo -e "    $ENV_FILE"
echo ""
echo -e "  To uninstall:"
echo -e "    bash setup-cswn uninstall"
echo ""
success "73 de Colorado Severe Weather Network — setup complete!"
